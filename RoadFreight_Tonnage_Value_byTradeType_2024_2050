<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Washington Freight Trade, 2024 and 2050</title>
<style>
:root{--text:#545454;--grid:#e7e7e7;--leader:#999}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:#fff;font-family:Arial,Helvetica,sans-serif;color:var(--text);
  min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
.figure{max-width:1420px;width:100%;margin:0 auto;padding:26px 28px 18px;position:relative}
.charts{display:grid;grid-template-columns:1fr 1fr;gap:55px}
.chart{min-width:0}
.chart svg{width:100%;height:auto;overflow:visible}
.grid{stroke:var(--grid);stroke-width:1}
.axis{stroke:#ccc;stroke-width:1}
.tick{fill:var(--text);font-size:20px}
.year{fill:var(--text);font-size:21px;font-weight:700}
.axis-title{fill:var(--text);font-size:21px}
.outside{fill:#3f3f3f;font-size:20px;pointer-events:none}
.inside{fill:#fff;font-size:20px;pointer-events:none}
.inside.dark{fill:#333}
.leader{stroke:var(--leader);stroke-width:2;fill:none;pointer-events:none}
.seg{cursor:pointer;transition:opacity .15s ease}
.seg:focus{outline:3px solid #1a73e8;outline-offset:2px}
.legend{display:flex;justify-content:center;align-items:flex-start;gap:25px;flex-wrap:wrap;margin-top:5px;font-size:18px;color:#111}
.legend-item{display:flex;gap:9px;align-items:center;line-height:1.05;cursor:default;padding:3px 6px;border-radius:4px;transition:background .15s ease}
.legend-item.active{background:#f0f4f8}
.swatch{width:29px;height:29px;flex:0 0 29px;border-radius:2px}
.tooltip{position:fixed;pointer-events:none;background:#20303d;color:#fff;font-size:14px;line-height:1.4;padding:9px 12px;border-radius:6px;box-shadow:0 4px 14px rgba(0,0,0,.25);opacity:0;transform:translate(-50%,-115%);transition:opacity .12s ease;z-index:20;max-width:240px}
.tooltip.show{opacity:1}
.tooltip b{display:block;font-size:15px;margin-bottom:2px}
@media(max-width:850px){
  .figure{padding:18px 14px}
  .charts{grid-template-columns:1fr;gap:28px}
  .legend{justify-content:flex-start;gap:14px;font-size:15px}
  .swatch{width:22px;height:22px;flex-basis:22px}
}
</style>
</head>
<body>
<main class="figure" role="figure" aria-label="Two stacked bar charts compare 2024 and 2050 Washington freight tonnage and value by trade type. Hover or focus a segment for details.">
  <div class="charts">
    <section class="chart" aria-label="Tonnage in million tons"><svg id="tonnage" viewBox="0 0 650 430" role="img"></svg></section>
    <section class="chart" aria-label="Value in billion 2017 dollars"><svg id="value" viewBox="0 0 650 430" role="img"></svg></section>
  </div>
  <div class="legend" id="legend" aria-label="Trade type legend"></div>
  <div class="tooltip" id="tooltip" role="status"></div>
</main>
<script>
const series=[
 {key:'Imports',label:'Imports',color:'#20dfe3'},
 {key:'Imports - Thru WA',label:'Imports -\nThru WA',color:'#0780a0'},
 {key:'Exports',label:'Exports',color:'#c9f4f2'},
 {key:'Exports - Thru WA',label:'Exports -\nThru WA',color:'#05aeb7'},
 {key:'Domestic - Within WA',label:'Domestic -\nWithin WA',color:'#005b58'},
 {key:'Domestic - to WA',label:'Domestic -\nto WA',color:'#008363'},
 {key:'Domestic - From WA',label:'Domestic –\nFrom WA',color:'#8cdb00'}
];
const charts={
 tonnage:{max:500,step:100,title:'Million Tons', divisor:1000, unit:'M tons', rows:{
  '2024':{'Imports':12801.74,'Imports - Thru WA':4526.31,'Exports':17729.26,'Exports - Thru WA':5939.99,'Domestic - Within WA':239261.50,'Domestic - to WA':34695.18,'Domestic - From WA':26565.60},
  '2050':{'Imports':24439.01,'Imports - Thru WA':5994.75,'Exports':41449.00,'Exports - Thru WA':12585.52,'Domestic - Within WA':346228.22,'Domestic - to WA':57128.50,'Domestic - From WA':47934.73}
 }},
 value:{max:800,step:200,title:'Billion Dollars (2017 Value)',divisor:1000,unit:'B $ (2017)',rows:{
  '2024':{'Imports':30247.07,'Imports - Thru WA':14896.83,'Exports':28402.07,'Exports - Thru WA':17654.33,'Domestic - Within WA':136503.21,'Domestic - to WA':84869.22,'Domestic - From WA':59714.19},
  '2050':{'Imports':66029.72,'Imports - Thru WA':27693.14,'Exports':39428.85,'Exports - Thru WA':31658.56,'Domestic - Within WA':254900.64,'Domestic - to WA':160197.57,'Domestic - From WA':128251.54}
 }}
};
const NS='http://www.w3.org/2000/svg';
function el(tag,a={},text=''){const n=document.createElementNS(NS,tag);Object.entries(a).forEach(([k,v])=>n.setAttribute(k,v));if(text)n.textContent=text;return n}
function pct(v,total){return Math.round(v/total*100)+'%'}
const tooltip=document.getElementById('tooltip');
function showTip(evt,html){tooltip.innerHTML=html;tooltip.classList.add('show');moveTip(evt)}
function moveTip(evt){tooltip.style.left=evt.clientX+'px';tooltip.style.top=evt.clientY+'px'}
function hideTip(){tooltip.classList.remove('show')}

function draw(id,c){
 const svg=document.getElementById(id), left=76,right=25,top=70,bottom=330,w=650-left-right, barH=58, ys=[102,240];
 for(let t=0;t<=c.max;t+=c.step){let x=left+t/c.max*w;svg.append(el('line',{x1:x,y1:top,x2:x,y2:bottom,class:'grid'}));svg.append(el('text',{x,y:360,'text-anchor':'middle',class:'tick'},String(t)))}
 svg.append(el('line',{x1:left,y1:top,x2:left,y2:bottom,class:'axis'}));
 svg.append(el('line',{x1:left,y1:bottom,x2:left+w,y2:bottom,class:'axis'}));

 Object.entries(c.rows).forEach(([year,row],ri)=>{
  const y=ys[ri],total=Object.values(row).reduce((a,b)=>a+b,0);
  let cursor=left;
  svg.append(el('text',{x:left-18,y:y+36,'text-anchor':'end',class:'year'},year));

  series.forEach((s,i)=>{
   const valRaw=row[s.key], val=valRaw/c.divisor, rw=val/c.max*w, center=cursor+rw/2;
   const rect=el('rect',{x:cursor,y,width:rw,height:barH,fill:s.color,class:'seg',tabindex:'0',role:'img','aria-label':`${s.label.replace('\n',' ')}, ${year}: ${pct(valRaw,total)} of total, ${val.toFixed(1)} ${c.unit}`});
   const tipHtml=()=>`<b>${s.label.replace('\n',' ')} — ${year}</b>${val.toLocaleString(undefined,{maximumFractionDigits:1})} ${c.unit} (${pct(valRaw,total)} of total)`;
   rect.addEventListener('mouseenter',e=>{highlight(svg,rect);showTip(e,tipHtml())});
   rect.addEventListener('mousemove',moveTip);
   rect.addEventListener('mouseleave',()=>{unhighlight(svg);hideTip()});
   rect.addEventListener('focus',e=>{highlight(svg,rect);showTip({clientX:rect.getBoundingClientRect().x+20,clientY:rect.getBoundingClientRect().y},tipHtml())});
   rect.addEventListener('blur',()=>{unhighlight(svg);hideTip()});
   svg.append(rect);

   const label=pct(valRaw,total), enough=rw>48;
   if(enough){
    svg.append(el('text',{x:center,y:y+37,'text-anchor':'middle',class:'inside'+(i===2||i===6?' dark':'')},label));
   }else{
    const upper=((i+ri)%2===0);
    const tx=center+(i===0?-18:i===6?24:0);
    const barEdgeY=upper?y:y+barH;
    const lineBendY=upper?y-30:y+barH+30;
    const textY=upper?lineBendY-12:lineBendY+24;
    svg.append(el('path',{d:`M ${center} ${barEdgeY} L ${center} ${lineBendY} L ${tx} ${lineBendY}`,class:'leader'}));
    svg.append(el('text',{x:tx,y:textY,'text-anchor':'middle',class:'outside'},label));
   }
   cursor+=rw;
  });
 });
 svg.append(el('text',{x:left+w/2,y:398,'text-anchor':'middle',class:'axis-title'},c.title));
}

function highlight(svg,activeRect){
 svg.querySelectorAll('rect.seg').forEach(r=>{
  if(r===activeRect){r.style.opacity='1';r.style.stroke='#20303d';r.style.strokeWidth='2';}
  else{r.style.opacity='0.35';r.style.stroke='none';}
 });
}
function unhighlight(svg){
 svg.querySelectorAll('rect.seg').forEach(r=>{r.style.opacity='1';r.style.stroke='none';});
}

draw('tonnage',charts.tonnage);
draw('value',charts.value);

const legend=document.getElementById('legend');
series.forEach(s=>{
 const item=document.createElement('div');
 item.className='legend-item';
 item.tabIndex=0;
 const sw=document.createElement('span');sw.className='swatch';sw.style.background=s.color;
 const label=document.createElement('span');label.innerHTML=s.label.replace('\n','<br>');
 item.append(sw,label);
 const setActive=on=>{
  document.querySelectorAll('svg').forEach(svg=>{
   svg.querySelectorAll('rect.seg').forEach(r=>{
    if(r.getAttribute('fill')===s.color){r.style.opacity='1';r.style.stroke='#20303d';r.style.strokeWidth='2';}
    else if(on){r.style.opacity='0.35';r.style.stroke='none';}
    else{r.style.opacity='1';r.style.stroke='none';}
   });
  });
  item.classList.toggle('active',on);
 };
 item.addEventListener('mouseenter',()=>setActive(true));
 item.addEventListener('mouseleave',()=>setActive(false));
 item.addEventListener('focus',()=>setActive(true));
 item.addEventListener('blur',()=>setActive(false));
 legend.append(item);
});
</script>
</body></html>
